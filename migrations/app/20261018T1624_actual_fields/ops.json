    "id": "table.users",
    "label": "Create table \"users\"",
    "summary": "Creates table \"users\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "users"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"users\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"users\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"users\"",
        "sql": "CREATE TABLE \"public\".\"users\" (\n  \"auth_provider\" character varying(50) DEFAULT 'auth0' NOT NULL,\n  \"auth_subject\" character varying(255),\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"deleted_at\" timestamptz,\n  \"email\" character varying(255) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"image_url\" text,\n  \"is_active\" bool DEFAULT true NOT NULL,\n  \"name\" character varying(150) NOT NULL,\n  \"updated_at\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"users\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"users\""
        ]
      }
    ]
  },
  {
    "id": "unique.users.users_email_key",
    "label": "Add unique constraint on \"users\" (email)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "users_email_key",
        "table": "users"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"users_email_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "users_email_key",
          "public",
          "\"public\".\"users\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"users_email_key\"",
        "sql": "ALTER TABLE \"public\".\"users\" ADD CONSTRAINT \"users_email_key\" UNIQUE (\"email\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"users_email_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "users_email_key",
          "public",
          "\"public\".\"users\""
        ]
      }
    ]
  },
