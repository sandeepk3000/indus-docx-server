        "sql": "CREATE TABLE \"public\".\"courses\" (\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"created_by_id\" uuid NOT NULL,\n  \"deleted_at\" timestamptz,\n  \"description\" text,\n  \"id\" uuid NOT NULL,\n  \"level\" text DEFAULT 'BEGINNER' NOT NULL,\n  \"published_at\" timestamptz,\n  \"slug\" character varying(280) NOT NULL,\n  \"status\" text DEFAULT 'DRAFT' NOT NULL,\n  \"thumbnail_url\" text,\n  \"title\" text NOT NULL,\n  \"updated_at\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"courses_level_check_85a47cbd\" CHECK (\"level\" IN ('BEGINNER', 'INTERMEDIATE', 'ADVANCED')),\n  CONSTRAINT \"courses_status_check_bc64f66b\" CHECK (\"status\" IN ('DRAFT', 'PUBLISHED', 'ARCHIVED'))\n)",
